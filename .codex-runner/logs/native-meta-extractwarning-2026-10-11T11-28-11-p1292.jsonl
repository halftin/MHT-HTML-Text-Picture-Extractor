lvm的MHT资源提取器项目打包工作流程.md:2426:| 编译 + 全量单测 | `mvnw.cmd clean test`（不加 `-q`） | 默认 **768 / 0**、`headless-layer-b` **68 / 0**、`BUILD SUCCESS` |\r\n基于graalvm的MHT资源提取器项目打包工作流程.md:2444:先用 `NATIVE_TARGET=headless` 构建 `MhtExtractorBackend.exe`，再构建 JavaFX 发行目录。\r\n基于graalvm的MHT资源提取器项目打包工作流程.md:2450:该变量默认 `H:\\TEST\\mht\\p4-3-headless-dist`；发布时应显式指向本次、同一构建标识的无头产物目录。\r\n基于graalvm的MHT资源提取器项目打包工作流程.md:2464:本机验证时显式设置 `JAVA_TOOL_OPTIONS=-Djava.io.tmpdir=H:\\TEST\\temp`，并将 `TEMP` / `TMP`、\r\n<#\r\n  Compile NativePreviewCacheProbe into a REAL native image, then load JVM-written caches.\r\n  Like native-card-smoke.ps1, JVM success alone is not acceptance evidence.\r\n  Use -MetadataDir to select a pre-fix snapshot for the red control without editing sources.\r\n  -OutDir must be a fresh directory; target/classes metadata is excluded from the classpath.\r\n  Requires a packaged target/lib, vcvars64.bat environment, and agent-generated fixtures.\r\n  Exit: 0 = both list shapes pass, 1 = probe/build failure, 20 = MSVC unavailable.\r\n#>\r\n[CmdletBinding()]\r\nparam(\r\n    [Parameter(Mandatory = $true)][string]$OutDir,\r\n    [Parameter(Mandatory = $true)][string]$FixtureRoot,\r\n    [string]$Repo = '',\r\n    [string]$MetadataDir = '',\r\n    [string]$JavaHome = $env:JAVA_HOME,\r\n    [string]$NativeImage = '',\r\n    [string]$TempDir = $env:TEMP,\r\n    [int]$TimeoutSec = 60\r\n)\r\n$ErrorActionPreference = 'Stop'\r\nif (-not $Repo) { $Repo = Split-Path -Parent (Split-Path -Parent $PSScriptRoot) }\r\nif (-not (Get-Command link.exe -ErrorAction SilentlyContinue)) {\r\n    Write-Output '[preview-smoke] MSVC unavailable; call vcvars64.bat first'\r\n    exit 20\r\n}\r\nif (-not $MetadataDir) { $MetadataDir = Join-Path $Repo 'src\\main\\resources\\META-INF\\native-image\\com.mhtextractor' }\r\nif (-not $NativeImage) { $NativeImage = Join-Path $JavaHome 'bin\\native-image.cmd' }\r\nif (-not $TempDir -or -not (Test-Path -LiteralPath $TempDir)) { throw 'Pass an existing -TempDir' }\r\nif ($TimeoutSec -le 0) { throw 'TimeoutSec must be positive' }\r\n$OutDir = [IO.Path]::GetFullPath($OutDir)\r\nif (Test-Path -LiteralPath $OutDir) { throw \"Use a fresh OutDir: $OutDir\" }\r\nNew-Item -ItemType Directory -Path $OutDir -Force | Out-Null\r\n$env:TEMP = $TempDir\r\n$env:TMP = $TempDir\r\n$env:JAVA_TOOL_OPTIONS = '-Djava.io.tmpdir=' + $TempDir\r\n$classes = Join-Path $OutDir 'classes'\r\nNew-Item -ItemType Directory -Path $classes -Force | Out-Null\r\n# Copy classes/resources, never the automatic production native-image configuration.\r\n$sourceClasses = Join-Path $Repo 'target\\classes'\r\nforeach ($file in Get-ChildItem -LiteralPath $sourceClasses -Recurse -File) {\r\n    $relative = $file.FullName.Substring($sourceClasses.Length + 1)\r\n    if ($relative -like 'META-INF\\native-image\\*') { continue }\r\n    $dest = Join-Path $classes $relative\r\n    New-Item -ItemType Directory -Path ([IO.Path]::GetDirectoryName($dest)) -Force | Out-Null\r\n    Copy-Item -LiteralPath $file.FullName -Destination $dest\r\n}\r\n$metadataCopy = Join-Path $OutDir 'metadata'\r\nCopy-Item -LiteralPath $MetadataDir -Destination $metadataCopy -Recurse\r\n$deps = (Get-ChildItem -LiteralPath (Join-Path $Repo 'target\\lib') -Filter '*.jar' -File |\r\n    Sort-Object Name | ForEach-Object FullName) -join ';'\r\nif (-not $deps) { throw 'Missing target/lib; run Maven package first' }\r\n$cp = $classes + ';' + $deps\r\nfunction Invoke-Checked([string]$Program, [string[]]$Arguments) {\r\n    Write-Output ('COMMAND: \"' + $Program + '\" ' + (($Arguments | ForEach-Object { '\"' + $_ + '\"' }) -join ' '))\r\n    & $Program @Arguments\r\n    $code = $LASTEXITCODE\r\n    Write-Output (\"COMMAND_EXIT=$code\")\r\n    if ($code -ne 0) { throw \"Command failed: $Program (exit=$code)\" }\r\n}\r\nInvoke-Checked (Join-Path $JavaHome 'bin\\javac.exe') @('-cp', $cp, '-d', $classes,\r\n    (Join-Path $Repo 'tools\\native\\NativePreviewCacheProbe.java'))\r\n$exe = Join-Path $OutDir 'NativePreviewCacheProbe.exe'\r\n# Mirror build-native.cmd: the NIK static JavaFX libs need prism_common.lib added explicitly at link\r\n# time (its _overrideNativeWindowHandle implementation lives there) and JNI must stay enabled.\r\n$prismCommonLib = Join-Path $JavaHome 'lib\\static\\windows-amd64\\prism_common.lib'\r\n$linkOpt = if (Test-Path -LiteralPath $prismCommonLib) { @('-H:+JNI', '-H:NativeLinkerOption=prism_common.lib') } else { @('-H:+JNI') }\r\nInvoke-Checked $NativeImage (@('-cp', $cp, 'NativePreviewCacheProbe', '--no-fallback', '-Ob',\r\n    '-J-Xmx4G', '-H:+ReportExceptionStackTraces', ('-H:ConfigurationFileDirectories=' + $metadataCopy),\r\n    '--initialize-at-run-time=com.sun.glass,com.sun.prism,com.sun.scenario,com.sun.javafx.font,com.sun.javafx.iio,com.sun.media,com.sun.webkit,com.sun.javafx.tk.quantum,com.sun.marlin') + $linkOpt + @(('-H:Path=' + $OutDir), '-H:Name=NativePreviewCacheProbe'))\r\nif (-not (Test-Path -LiteralPath $exe)) { throw 'native-image produced no executable' }\r\n# Process.ExitCode is unreliable on this host; retain the handle and read Win32 status.\r\nAdd-Type -TypeDefinition @'\r\nusing System;\r\nusing System.Runtime.InteropServices;\r\npublic static class NativePreviewCacheProcess {\r\n    [DllImport(\"kernel32.dll\", SetLastError = true)]\r\n    public static extern bool GetExitCodeProcess(IntPtr process, out uint code);\r\n}\r\n'@\r\n$logging = Join-Path $OutDir 'probe-logback.xml'\r\n[IO.File]::WriteAllText($logging, '<configuration><root level=\"OFF\" /></configuration>')\r\n$failed = 0\r\nforeach ($shape in @('nonempty','empty')) {\r\n    $runArgs = @((\"-Djava.io.tmpdir=$TempDir\"), (\"-Dlogback.configurationFile=$logging\"),\r\n        (Join-Path $FixtureRoot ('fixture-' + $shape)), $shape)\r\n    $quoted = ($runArgs | ForEach-Object { '\"' + $_ + '\"' }) -join ' '\r\n    Write-Output ('COMMAND: \"' + $exe + '\" ' + $quoted)\r\n    $stdout = Join-Path $OutDir ($shape + '.stdout.log')\r\n    $stderr = Join-Path $OutDir ($shape + '.stderr.log')\r\n    $proc = Start-Process -FilePath $exe -ArgumentList $quoted -WorkingDirectory $OutDir `\r\n        -WindowStyle Hidden -PassThru -RedirectStandardOutput $stdout -RedirectStandardError $stderr\r\n    try {\r\n        $handle = $proc.Handle\r\n        if (-not $proc.WaitForExit($TimeoutSec * 1000)) {\r\n            & taskkill.exe /PID $proc.Id /T /F\r\n            [void]$proc.WaitForExit(5000)\r\n            throw \"Probe timed out: $shape\"\r\n        }\r\n        [uint32]$code = 0\r\n        if (-not [NativePreviewCacheProcess]::GetExitCodeProcess($handle, [ref]$code)) {\r\n            throw 'Cannot read native process exit status'\r\n        }\r\n    } finally { $proc.Dispose() }\r\n    Get-Content -LiteralPath $stdout -Encoding UTF8\r\n    Get-Content -LiteralPath $stderr -Encoding UTF8\r\n    Write-Output (\"PROBE_${shape}_EXIT=$code\")\r\n    if ($code -ne 0) { $failed++ }\r\n}\r\nWrite-Output (\"[preview-smoke] RESULTS: \" + (2 - $failed) + \" passed, $failed failed\")\r\nif ($failed) { exit 1 }\r\nexit 0\r\nimport com.mhtextractor.cache.PreviewCacheKey;\r\nimport com.mhtextractor.cache.PreviewCacheMeta;\r\nimport com.mhtextractor.cache.PreviewCacheStore;\r\n\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.util.List;\r\nimport java.util.Map;\r\n\r\n/** Native regression for Jackson's reflective array allocation, including empty images. */\r\npublic final class NativePreviewCacheProbe {\r\n    public static void main(String[] args) throws Exception {\r\n        if (args.length != 2 || !(args[1].equals(\"empty\") || args[1].equals(\"nonempty\"))) {\r\n            throw new IllegalArgumentException(\"Usage: NativePreviewCacheProbe <fixture-root> empty|nonempty\");\r\n        }\r\n        Path fixture = Path.of(args[0]).toAbsolutePath().normalize();\r\n        var key = PreviewCacheKey.compute(fixture.resolve(\"source.mht\"), \"p4-19\",\r\n                PreviewCacheMeta.FORMAT_VERSION);\r\n        var store = new PreviewCacheStore(fixture.resolve(\"cache\"));\r\n        System.out.println(\"[probe] load=\" + store.dirFor(key).resolve(\"meta.json\"));\r\n        var meta = store.load(key).orElseThrow(() -> new AssertionError(\"cache miss\"));\r\n        int expectedCount = args[1].equals(\"empty\") ? 0 : 1;\r\n        if (meta.images().size() != expectedCount || !meta.imageMode()) {\r\n            throw new AssertionError(\"image metadata differs\");\r\n        }\r\n        if (meta.warnings().size() != 1\r\n                || !meta.warnings().getFirst().key().equals(\"extract.region.r2\")\r\n                || !meta.warnings().getFirst().args().equals(Map.of(\"start\", \"123\", \"end\", \"123\"))) {\r\n            throw new AssertionError(\"structured warning differs\");\r\n        }\r\n        if (expectedCount > 0) {\r\n            var image = meta.images().getFirst();\r\n            if (!image.file().equals(\"images/0001.png\") || !image.sourceId().equals(\"cid:p4-19\")\r\n                    || !image.originalName().equals(\"fixture.png\") || !image.detectedExt().equals(\"png\")\r\n                    || !image.warnings().equals(meta.warnings())\r\n                    || Files.size(store.imageFileFor(meta, 0)) == 0) {\r\n                throw new AssertionError(\"image or its warning differs\");\r\n            }\r\n        }\r\n        if (!store.listKeys().equals(List.of(key))) throw new AssertionError(\"listKeys differs\");\r\n        System.out.println(\"[PASS] native load/listKeys images=\" + expectedCount + \" warnings=1\");\r\n        // Serialize the same shape back: the app's rebuild path writes the cache BEFORE any read.\r\n        if (expectedCount == 0) {\r\n            var writeRoot = Files.createTempDirectory(\"p4-19-native-write\");\r\n            var writeStore = new PreviewCacheStore(writeRoot);\r\n            writeStore.write(key, meta, dir -> { });\r\n            if (writeStore.load(key).isEmpty()) throw new AssertionError(\"write/load round-trip missed\");\r\n            System.out.println(\"[PASS] native write/load round-trip images=0\");\r\n        }\r\n    }\r\n}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -Encoding UTF8 tools/native/assert-headless-metadata.ps1; Get-Content -Encoding UTF8 tools/native/audit-native-metadata.ps1 | Select-Object -First 150; rg -n 'ExtractWarning|PreviewCacheMeta|methods' tools/native/headless/reachability-metadata.json src/main/resources/META-INF/native-image/com.mhtextractor/reachability-metadata.json; Get-PSDrive -PSProvider FileSystem; rg --files tools/ipc tools/native\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -Encoding UTF8 tools/native/assert-headless-metadata.ps1; Get-Content -Encoding UTF8 tools/native/audit-native-metadata.ps1 | Select-Object -First 150; rg -n 'ExtractWarning|PreviewCacheMeta|methods' tools/native/headless/reachability-metadata.json src/main/resources/META-INF/native-image/com.mhtextractor/reachability-metadata.json; Get-PSDrive -PSProvider FileSystem; rg --files tools/ipc tools/native\"","aggregated_output":"# Assert the exact metadata snapshot passed to native-image, including after build.\r\nparam(\r\n    [Parameter(Mandatory = $true)][string]$MetadataDir,\r\n    [string]$AnalysisDir\r\n)\r\n$ErrorActionPreference = 'Stop'\r\ntry {\r\n    if (-not (Test-Path -LiteralPath (Join-Path $MetadataDir 'reachability-metadata.json'))) {\r\n        throw 'Missing headless reachability-metadata.json.'\r\n    }\r\n    $files = @(Get-ChildItem -LiteralPath $MetadataDir -Recurse -File |\r\n        Where-Object { $_.Extension -in @('.json','.properties') })\r\n    foreach ($file in $files) {\r\n        $text = [IO.File]::ReadAllText($file.FullName)\r\n        if ($file.Extension -eq '.json') {\r\n            # Validate JSON, then decode Unicode escapes before the text assertion.\r\n            $null = ConvertFrom-Json -InputObject $text\r\n            $text = [regex]::Replace($text, '\\\\u([0-9a-fA-F]{4})', {\r\n                param($match)\r\n                [string][char][Convert]::ToInt32($match.Groups[1].Value, 16)\r\n            })\r\n        }\r\n        if ($text -match 'javafx[./\\\\]') { throw \"JavaFX entry in $($file.FullName)\" }\r\n    }\r\n    \"[headless] metadata assertion: $($files.Count) files / 0 JavaFX entries (decoded JSON + properties text)\"\r\n    if ($AnalysisDir) {\r\n        $reports = @(Get-ChildItem -LiteralPath $AnalysisDir -Recurse -File |\r\n            Where-Object { $_.Name -like 'class_initialization*.csv' })\r\n        if ($reports.Count -eq 0) { throw 'Missing native-image class initialization analysis.' }\r\n        foreach ($report in $reports) {\r\n            if ([IO.File]::ReadAllText($report.FullName) -match 'javafx[./\\\\]') {\r\n                throw \"JavaFX type in native-image analysis: $($report.FullName)\"\r\n            }\r\n        }\r\n        \"[headless] image analysis assertion: $($reports.Count) reports / 0 JavaFX types\"\r\n    }\r\n    exit 0\r\n} catch {\r\n    [Console]::Error.WriteLine('[headless] metadata assertion FAILED: ' + $_.Exception.Message)\r\n    exit 1\r\n}\r\n<#\r\n  audit-native-metadata.ps1 - find STALE entries in the GraalVM reachability metadata.\r\n\r\n  A stale entry is a registered type whose class does not exist in ANY artifact the native\r\n  build actually sees: the classpath (target/lib/*.jar), the shaded app jar, target/classes,\r\n  and the JDK module images (both the build JDK and the native-image JDK).\r\n\r\n  Why: the metadata is a union of many tracing-agent runs accumulated over time. Classes that\r\n  were removed by a JavaFX upgrade or by a project refactor keep their registrations forever\r\n  (e.g. JavaFX-8-only com.sun.javafx.scene.control.skin.*Skin, or the app's own deleted\r\n  JavaFxUtil$SmoothProgressProperty). They do not break the build, but they make it impossible\r\n  to tell which registrations are real.\r\n\r\n  Usage:\r\n    powershell -NoProfile -ExecutionPolicy Bypass -File tools\\native\\audit-native-metadata.ps1\r\n    ... -ExtraJdk \"D:\\path\\to\\graalvm\" -WritePlan .claude-work\\stale-plan.json\r\n\r\n  Exit codes: 0 = audit ran (stale count may be > 0), 1 = inputs missing.\r\n#>\r\n[CmdletBinding()]\r\nparam(\r\n    [string]$Repo = \"\",\r\n    [string]$MetaDir = \"\",\r\n    [string]$JdkHome = $env:JAVA_HOME,\r\n    [string[]]$ExtraJdk = @(),\r\n    [string]$WritePlan = \"\",\r\n    [string]$AgentDir = \"\"\r\n)\r\n$ErrorActionPreference = 'Stop'\r\nif ([string]::IsNullOrWhiteSpace($Repo)) {\r\n    $Repo = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)\r\n    if (-not (Test-Path (Join-Path $Repo 'build-native.cmd'))) { $Repo = (Get-Location).Path }\r\n}\r\nif ([string]::IsNullOrWhiteSpace($MetaDir)) { $MetaDir = Join-Path $Repo 'src\\main\\resources\\META-INF\\native-image\\com.mhtextractor' }\r\nif (-not (Test-Path $MetaDir)) { Write-Host \"[audit] [ERROR] metadata dir not found: $MetaDir\"; exit 1 }\r\nif (-not (Test-Path (Join-Path $Repo 'target\\classes'))) { Write-Host \"[audit] [ERROR] target/classes missing - run a package first\"; exit 1 }\r\n\r\nAdd-Type -AssemblyName System.IO.Compression.FileSystem\r\n\r\n# ---- per-file registered types ----\r\n$perFile = @{}\r\n$all = New-Object 'System.Collections.Generic.HashSet[string]'\r\nforeach ($f in (Get-ChildItem $MetaDir -Filter '*.json' | Sort-Object Name)) {\r\n    $set = New-Object 'System.Collections.Generic.HashSet[string]'\r\n    try {\r\n        $obj = ([System.IO.File]::ReadAllText($f.FullName).TrimStart([char]0xFEFF)) | ConvertFrom-Json\r\n        $stack = New-Object System.Collections.Stack\r\n        $stack.Push($obj)\r\n        while ($stack.Count -gt 0) {\r\n            $cur = $stack.Pop()\r\n            if ($null -eq $cur) { continue }\r\n            if ($cur -is [System.Management.Automation.PSCustomObject]) {\r\n                foreach ($p in $cur.PSObject.Properties) {\r\n                    if (($p.Name -eq 'type' -or $p.Name -eq 'name') -and $p.Value -is [string] -and $p.Value -match '\\.' -and $p.Value -notmatch '/') { [void]$set.Add($p.Value); [void]$all.Add($p.Value) }\r\n                    elseif ($p.Value -is [System.Management.Automation.PSCustomObject] -or $p.Value -is [System.Array]) { $stack.Push($p.Value) }\r\n                }\r\n            } elseif ($cur -is [System.Array]) { foreach ($x in $cur) { $stack.Push($x) } }\r\n        }\r\n    } catch { Write-Host (\"[audit] [warn] cannot parse \" + $f.Name + \": \" + $_.Exception.Message) }\r\n    $perFile[$f.Name] = $set\r\n}\r\nWrite-Host (\"[audit] registered types = \" + $all.Count)\r\n\r\n# ---- available classes ----\r\n$avail = New-Object 'System.Collections.Generic.HashSet[string]'\r\nfunction Add-Jar([string]$p) {\r\n    if (-not (Test-Path $p)) { return }\r\n    try {\r\n        $z = [System.IO.Compression.ZipFile]::OpenRead($p)\r\n        foreach ($e in $z.Entries) { if ($e.FullName.EndsWith('.class')) { [void]$script:avail.Add((($e.FullName -replace '/', '.') -replace '\\.class$', '')) } }\r\n        $z.Dispose()\r\n    } catch { }\r\n}\r\nforeach ($j in (Get-ChildItem (Join-Path $Repo 'target\\lib') -Filter '*.jar' -ErrorAction SilentlyContinue).FullName) { Add-Jar $j }\r\n$shaded = Get-ChildItem (Join-Path $Repo 'target') -Filter 'mhtExtractor-*.jar' -ErrorAction SilentlyContinue | Select-Object -First 1\r\nif ($shaded) { Add-Jar $shaded.FullName }\r\n$classesDir = Join-Path $Repo 'target\\classes'\r\nGet-ChildItem $classesDir -Recurse -Filter '*.class' | ForEach-Object {\r\n    $rel = $_.FullName.Substring($classesDir.Length + 1)\r\n    [void]$avail.Add((($rel -replace '\\\\', '.') -replace '\\.class$', ''))\r\n}\r\nWrite-Host (\"[audit] classpath + JavaFX + app classes = \" + $avail.Count)\r\n\r\n$jdkList = @()\r\nif ($JdkHome) { $jdkList += $JdkHome }\r\n$jdkList += $ExtraJdk\r\nforeach ($jdk in ($jdkList | Where-Object { $_ } | Sort-Object -Unique)) {\r\n    $ji = Join-Path $jdk 'bin\\jimage.exe'\r\n    $mods = Join-Path $jdk 'lib\\modules'\r\n    if (-not (Test-Path $ji) -or -not (Test-Path $mods)) { Write-Host (\"[audit] [warn] skip JDK (no jimage): \" + $jdk); continue }\r\n    $n = 0\r\n    foreach ($l in (& $ji list $mods 2>$null)) {\r\n        $line = ([string]$l).Trim()\r\n        if ($line -eq '' -or $line.StartsWith('Module:') -or $line.StartsWith('jimage:')) { continue }\r\n        if ($line.EndsWith('.class')) {\r\n            $p = $line\r\n            if ($p.StartsWith('/'))