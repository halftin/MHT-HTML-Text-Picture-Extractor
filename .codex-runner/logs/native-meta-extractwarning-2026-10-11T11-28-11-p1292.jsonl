ct-Object -Last 12\r\n    }\r\n} else {\r\n    Step 'compile-for-gui' {\r\n        & $MVN -q '-DskipTests' compile 2>&1 | Select-Object -Last 3\r\n    }\r\n}\r\n[INFO] Running com.mhtextractor.cache.PreviewCacheKeyTest\r\n[INFO] Tests run: 9, Failures: 0, Errors: 0, Skipped: 0, Time elapsed: 0.095 s -- in com.mhtextractor.cache.PreviewCacheKeyTest\r\n[INFO] Running com.mhtextractor.cache.PreviewCacheLifecycleTest\r\n[INFO] Tests run: 20, Failures: 0, Errors: 0, Skipped: 0, Time elapsed: 1.553 s -- in com.mhtextractor.cache.PreviewCacheLifecycleTest\r\n[INFO] Running com.mhtextractor.cache.PreviewCacheStoreTest\r\npackage nativeprobe;\r\n\r\nimport com.mhtextractor.baseline.BaselineCases;\r\nimport com.mhtextractor.i18n.I18n;\r\n\r\nimport java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\nimport java.util.Locale;\r\n\r\n/**\r\n * Headless acceptance probe: runs the project's own golden product-baseline suite\r\n * (BaselineCases: 16 cases x 2 locales) and compares every produced artifact\r\n * byte-for-byte (per-file SHA-256 + content digests) against\r\n * src/test/resources/baselines/&lt;case&gt;.&lt;loc&gt;.json.\r\n *\r\n * Mirrors ProductBaselineTest, including its determinism self-check (each case runs\r\n * twice into independent directories; both summaries must be identical).\r\n *\r\n * Must be run with CWD = repository root (BaselineCases.FIXTURE_DIR is relative).\r\n * argv[0] = work root (default .claude-work/native-baseline-run).\r\n */\r\npublic class NativeBaselineProbe {\r\n\r\n    public static void main(String[] args) throws Exception {\r\n        Path baselineDir = Path.of(\"src\", \"test\", \"resources\", \"baselines\");\r\n        Path workRoot = Path.of(args.length > 0 ? args[0] : \".claude-work/native-baseline-run\");\r\n        Files.createDirectories(workRoot);\r\n\r\n        List<String> failures = new ArrayList<>();\r\n        int passe