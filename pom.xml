<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mhtextractor</groupId>
    <artifactId>mhtExtractor</artifactId>
    <version>2.6-beta</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Liberica NIK 25 统一编译和 native-image -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 依赖版本统一管理 -->
        <javafx.version>25.0.3</javafx.version>
        <lombok.version>1.18.44</lombok.version>
        <jakarta.mail.version>2.0.2</jakarta.mail.version>
        <jackson.version>2.18.6</jackson.version>
        <logback.version>1.5.26</logback.version>
        <slf4j.version>2.0.9</slf4j.version>
        <jsoup.version>1.18.1</jsoup.version>

        <atlantafx.version>2.1.0</atlantafx.version>
    </properties>

    <dependencies>
        <!-- ==================== JavaFX 依赖 ==================== -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>



        <!-- ==================== Lombok ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ==================== MIME / MHT 解析 ==================== -->
        <!-- Jakarta Mail (原 JavaMail) 用于解析 MIME 格式的 MHT 文件 -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>${jakarta.mail.version}</version>
        </dependency>

        <!-- ==================== JSON 配置管理 ==================== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- 支持 Java 8 时间类型 (LocalDateTime 等) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ==================== HTML 解析 ==================== -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- ==================== WebP 解码（纯 Java，预览缩略图用） ==================== -->
        <dependency>
            <groupId>org.glavo</groupId>
            <artifactId>webp</artifactId>
            <version>0.2.0</version>
        </dependency>

        <!-- ==================== 日志框架 ==================== -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- ==================== AtlantaFX 主题 ==================== -->
        <!-- 纯 CSS 主题库，无需替换现有控件 -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- ==================== Ikonli 图标库 ==================== -->

        <!-- Ikonli 核心库 -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.3.1</version>
        </dependency>

        <!-- FontAwesome 5 图标包 -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-fontawesome5-pack</artifactId>
            <version>12.3.1</version>
        </dependency>

        <!-- ==================== 单元测试 ==================== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <!-- 包含 src/main/resources 下的所有资源 -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- 包含 src/main/java 下的 FXML 文件 -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.fxml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- 编译插件：确保 Lombok 注解被正确处理 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- 引用属性便于开发机覆盖（-Dmaven.compiler.release=21）；打包机默认 25 -->
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- 单元测试运行插件（JUnit 5） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <!--
                      默认执行：全部单测（JavaFX 在 classpath 上）。

                      第二个执行（headless-layer-b）：把 JavaFX **物理剔除**后重跑"无头层"测试。
                      这是验收 V1（app 层依赖闭包零 javafx）与 V2（桩 UI 可跑通）的**最强证据** ——
                      它不靠源码/字节码扫描断言，而是让"缺少 JavaFX 时也能跑"成为运行时事实：
                      无头闭包中任何一处触碰 javafx.* 都会以 NoClassDefFoundError 直接失败。

                      被纳入的测试只允许依赖"零 JavaFX 的业务闭包"：
                        LayerBTest（无头门面端到端 + 与产物基线逐字节比对）
                        WorkspaceParamServiceTest（app 层缓存规则服务）
                      注意：它们不得直接或间接 import javafx.*;
                    -->
                    <execution>
                        <id>headless-layer-b</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <test>
                                com.mhtextractor.app.LayerBTest,com.mhtextractor.app.WorkspaceParamServiceTest,com.mhtextractor.app.ExtractionPreconditionsTest,com.mhtextractor.app.WorkspaceModelTest,com.mhtextractor.app.StubUiAcceptanceTest
                            </test>
                            <!-- 标识"这是无头执行"：LayerBTest 据此自我断言 JavaFX 确实不可加载（见下方 argLine） -->
                            <systemPropertyVariables>
                                <mht.headless.execution>1</mht.headless.execution>
                            </systemPropertyVariables>
                            <!--
                              让"无 JavaFX"真正成立需要 **两个条件同时满足**（2026-09-26 实测，缺一不可）：

                              条件 A（argLine）：把 boot layer 限定在 java.se，于是 JDK **内置为运行时模块**的
                                7 个 javafx.* 模块（javafx.base/controls/fxml/graphics/media/swing/web）
                                不再可解析。为什么必须：Liberica Full JDK 把 JavaFX 作为 JDK 模块提供，
                                classpathDependencyExcludes 只能剔 Maven 依赖，剔不掉 JDK 模块。
                                （实测：GUI 运行时 JVM stderr 显示 JavaFX 来自 jrt:/javafx.graphics。）

                              条件 B（classpathDependencyExcludes）：把 JavaFX **jar** 全部剔出 classpath。
                                为什么必须：argLine 的限制只作用于 **模块层**；classpath（未命名模块）上的
                                同名类仍可被加载（已实测：classpath 带 javafx-base-win.jar 时，
                                加不加该 argLine 都能 Class.forName 成功）。两个条件因此互补。

                              坐标必须 **带 classifier 与不带 classifier 各写一遍**：
                                实际依赖是 org.openjfx:javafx-*:win，同时带出无 classifier 的传递变体。
                                本参数只排除与给出的 groupId:artifactId **完全相等** 的坐标，不做前缀匹配。
                                旧写法只写无 classifier 的四条，等于放过了真正的 win jar
                                （已用 mvn -X 核对 forked classpath：修复前两种 jar 同时在场）。

                              注意：该选项是 **launcher 选项**而非 JVM 选项，只能经 surefire 的 argLine 传入
                              （surefire 会拼在 classpath 参数之前）。经 JAVA_TOOL_OPTIONS / _JAVA_OPTIONS
                              传入会直接报 "Unrecognized option"，已实测，勿再尝试。

                              ⚠️ 本注释内严禁出现连续两个短横线（XML 注释语法限制，含中文破折号），
                              故选项名一律写在下方 argLine 元素里，注释中不复述。

                              副作用：被纳入本次执行的 5 个测试类不再能使用 java.se 之外的 JDK 模块。
                              它们覆盖导入 / 校验 / 建组 / 参数 / 缓存规则 / 文本与图片提取（含 i18n 资源
                              与临时目录 IO），实测 44 项全绿；若日后这些测试需要新增非 java.se 模块，
                              本 argLine 需一并复核。
                            -->
                            <argLine>--limit-modules java.se</argLine>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>org.openjfx:javafx-controls</classpathDependencyExclude>
                                <classpathDependencyExclude>org.openjfx:javafx-fxml</classpathDependencyExclude>
                                <classpathDependencyExclude>org.openjfx:javafx-graphics</classpathDependencyExclude>
                                <classpathDependencyExclude>org.openjfx:javafx-base</classpathDependencyExclude>
                                <classpathDependencyExclude>org.openjfx:javafx-controls:win</classpathDependencyExclude>
                                <classpathDependencyExclude>org.openjfx:javafx-fxml:win</classpathDependencyExclude>
                                <classpathDependencyExclude>org.openjfx:javafx-graphics:win</classpathDependencyExclude>
                                <classpathDependencyExclude>org.openjfx:javafx-base:win</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 打包插件：生成包含所有依赖的可执行 JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <!-- 设置主类入口 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.mhtextractor.App</mainClass>
                                </transformer>
                                <!-- 合并 Logback 配置中可能出现的多个 service 文件 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <!-- 排除一些可能引起冲突的签名文件 -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 依赖复制插件：将所有依赖复制到 target/lib 目录 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JavaFX 运行插件：方便在开发阶段直接运行 -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.mhtextractor.App</mainClass>
                </configuration>
            </plugin>

            <!-- exec-maven-plugin：用于运行测试工具类 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <properties>
                <native.config.dir>${project.basedir}/src/main/resources/META-INF/native-image/com.mhtextractor</native.config.dir>
            </properties>
            <build>
                <resources>
                    <!-- 包含 src/main/resources 下的所有资源（含 native-image 配置） -->
                    <resource>
                        <directory>src/main/resources</directory>
                        <includes>
                            <include>**/*</include>
                        </includes>
                    </resource>
                    <!-- 包含 src/main/java 下的 FXML 文件 -->
                    <resource>
                        <directory>src/main/java</directory>
                        <includes>
                            <include>**/*.fxml</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>