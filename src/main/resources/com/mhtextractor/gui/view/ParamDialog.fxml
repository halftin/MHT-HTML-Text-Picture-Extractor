<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import atlantafx.base.controls.ToggleSwitch?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mhtextractor.gui.controller.ParamDialogController"
            prefWidth="640" prefHeight="620">

    <!-- 参数区（滚动）：文本参数组与图片参数组，按当前模式显示其一 -->
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="12">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <!-- ============ 文本提取参数组 ============ -->
                <VBox fx:id="textParamsBox" spacing="12">

                    <!-- 章节与标题 -->
                    <TitledPane fx:id="textTitlePane" text="章节与标题" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="addChapterNumberCheck" text="自动添加章节序号（第一章、第二章...）"/>
                            <ToggleSwitch fx:id="enableTitleExtractCheck" text="提取网页内标题"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="标题起始标记:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="titleStartMarkerField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="标题结束标记:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="titleEndMarkerField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                            <ToggleSwitch fx:id="titleUseRegexCheck" text="标题标记使用正则表达式"/>
                        </VBox>
                    </TitledPane>

                    <!-- 内容限定 -->
                    <TitledPane fx:id="textContentLimitPane" text="内容区域限定" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="enableLimitCheck" text="启用内容区域限定"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="起始标记:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="startMarkerField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="结束标记:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="endMarkerField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                            <ToggleSwitch fx:id="useRegexCheck" text="标记使用正则表达式"/>
                        </VBox>
                    </TitledPane>

                    <!-- 自定义模板 -->
                    <TitledPane fx:id="textTemplatePane" text="自定义模板" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="enableTemplateCheck" text="启用自定义模板"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="开头模板:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="startTemplateField" promptText="&#10; ========== START ==========&#10; " GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="结尾模板:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="endTemplateField" promptText="&#10; ========== END ==========&#10; " GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Label text="支持变量：{filename} {datetime} {date} {time} | 按 Enter 键插入 \n 换行符" styleClass="text-muted"/>
                        </VBox>
                    </TitledPane>

                    <!-- 输出模式 -->
                    <TitledPane fx:id="textOutputModePane" text="输出模式" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="separateFilesCheck" text="每个文件输出到独立 TXT（不勾选则合并为一个文件）"/>
                            <ToggleSwitch fx:id="autoFixEncodingCheck" text="自动修复编码乱码"/>
                        </VBox>
                    </TitledPane>
                </VBox>

                <!-- ============ 图片提取参数组 ============ -->
                <VBox fx:id="imageParamsBox" spacing="12">

                    <!-- 名称提取 -->
                    <TitledPane fx:id="imageNamePane" text="名称提取" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="imageNameExtractCheck" text="提取网页内标题，用于命名输出的图片文件夹"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="标题起始标记:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="imageNameStartField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="标题结束标记:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="imageNameEndField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>
                    </TitledPane>

                    <!-- 区域限定 -->
                    <TitledPane fx:id="imageRegionPane" text="内容区域限定" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="imageRegionExtractCheck" text="启用内容区域限定"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="起始标记:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="imageRegionStartField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="结束标记:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="imageRegionEndField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>
                    </TitledPane>

                    <!-- 图片处理 -->
                    <TitledPane fx:id="imageProcessPane" text="图片处理选项" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="imageRenameCheck" text="批量重命名图片（001.jpg、002.jpg...）"/>
                            <ToggleSwitch fx:id="imageZipCheck" text="ZIP 打包"/>
                            <ToggleSwitch fx:id="imageCbzCheck" text="CBZ 打包"/>
                        </VBox>
                    </TitledPane>

                    <!-- 输出模式 -->
                    <TitledPane fx:id="imageOutputModePane" text="输出模式" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="singleOutputCheck" text="所有图片合并到一个目录"/>
                        </VBox>
                    </TitledPane>

                    <!-- 性能 -->
                    <TitledPane fx:id="imagePerformancePane" text="性能" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="highSpeedMemoryCheck" text="高速内存模式（开启后占用大量内存）"/>
                        </VBox>
                    </TitledPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- 底部固定两行（不参与滚动）：倒数第二行=配置管理，最后一行=取消/确定 -->
    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="12" bottom="12" left="12"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="配置:"/>
                <ComboBox fx:id="configComboBox" prefWidth="180" promptText="选择配置"/>
                <Button text="加载" onAction="#onLoadConfig">
                    <tooltip>
                        <Tooltip text="加载配置仅填充参数界面，点击“确定”后才生效"/>
                    </tooltip>
                </Button>
                <Button text="保存" onAction="#onSaveConfig"/>
                <Button text="删除" onAction="#onDeleteConfig"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="cancelButton" text="取消" onAction="#onCancel"/>
                <Button fx:id="confirmButton" text="确定" onAction="#onConfirm" styleClass="action-button" defaultButton="true"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
