<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import atlantafx.base.controls.ToggleSwitch?>

<!-- 根是 fx:root：根节点与控制器是同一个对象 ParamFormPane。
     因此这里没有 fx:controller —— 载入方用 setRoot(实例)/setController(实例) 把同一个面板同时交给两者，
     这样"参数表单面板"本体可以被（Q6a 的）非模态侧边栏共用。其余属性/文案/布局逐字未变。 -->
<fx:root type="javafx.scene.layout.BorderPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         prefWidth="640" prefHeight="620">

    <!-- 参数区（滚动）：文本参数组与图片参数组，按当前模式显示其一 -->
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="12">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <!-- ============ 文本提取参数组 ============ -->
                <VBox fx:id="textParamsBox" spacing="12">

                    <!-- 章节与标题 -->
                    <TitledPane fx:id="textTitlePane" text="%param.tab.chapter" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="addChapterNumberCheck" text="%param.text.addChapterNumbers"/>
                            <ToggleSwitch fx:id="enableTitleExtractCheck" text="%param.text.extractTitle"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="%param.text.titleStartMarker" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="titleStartMarkerField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="%param.text.titleEndMarker" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="titleEndMarkerField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                            <ToggleSwitch fx:id="titleUseRegexCheck" text="%param.text.titleMarkerRegex"/>
                        </VBox>
                    </TitledPane>

                    <!-- 内容限定 -->
                    <TitledPane fx:id="textContentLimitPane" text="%param.text.areaTitle" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="enableLimitCheck" text="%param.text.areaEnable"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="%param.text.areaStartMarker" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="startMarkerField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="%param.text.areaEndMarker" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="endMarkerField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                            <ToggleSwitch fx:id="useRegexCheck" text="%param.text.areaMarkerRegex"/>
                        </VBox>
                    </TitledPane>

                    <!-- 自定义模板 -->
                    <TitledPane fx:id="textTemplatePane" text="%param.text.templateTitle" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="enableTemplateCheck" text="%param.text.templateEnable"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="%param.text.templateStart" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="startTemplateField" promptText="&#10; ========== START ==========&#10; " GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="%param.text.templateEnd" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="endTemplateField" promptText="&#10; ========== END ==========&#10; " GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Label text="%param.text.templateVars" styleClass="text-muted" wrapText="true"/>
                        </VBox>
                    </TitledPane>

                    <!-- 输出模式 -->
                    <TitledPane fx:id="textOutputModePane" text="%param.text.outputMode" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="separateFilesCheck" text="%param.text.separateTxt"/>
                            <ToggleSwitch fx:id="autoFixEncodingCheck" text="%param.text.fixEncoding"/>
                        </VBox>
                    </TitledPane>
                </VBox>

                <!-- ============ 图片提取参数组 ============ -->
                <VBox fx:id="imageParamsBox" spacing="12">

                    <!-- 名称提取 -->
                    <TitledPane fx:id="imageNamePane" text="%param.image.titleGroup" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="imageNameExtractCheck" text="%param.image.extractTitle"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="%param.image.titleStartMarker" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="imageNameStartField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="%param.image.titleEndMarker" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="imageNameEndField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>
                    </TitledPane>

                    <!-- 区域限定 -->
                    <TitledPane fx:id="imageRegionPane" text="%param.image.areaTitle" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="imageRegionExtractCheck" text="%param.image.areaEnable"/>
                            <GridPane hgap="8" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="%param.image.areaStartMarker" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="imageRegionStartField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="%param.image.areaEndMarker" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="imageRegionEndField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>
                    </TitledPane>

                    <!-- 图片处理 -->
                    <TitledPane fx:id="imageProcessPane" text="%param.image.processingTitle" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="imageRenameCheck" text="%param.image.rename"/>
                            <ToggleSwitch fx:id="imageZipCheck" text="%param.image.zip"/>
                            <ToggleSwitch fx:id="imageCbzCheck" text="%param.image.cbz"/>
                        </VBox>
                    </TitledPane>

                    <!-- 输出模式 -->
                    <TitledPane fx:id="imageOutputModePane" text="%param.image.outputMode" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="singleOutputCheck" text="%param.image.mergeDir"/>
                        </VBox>
                    </TitledPane>

                    <!-- 性能 -->
                    <TitledPane fx:id="imagePerformancePane" text="%param.image.performance" expanded="true">
                        <VBox spacing="8">
                            <ToggleSwitch fx:id="highSpeedMemoryCheck" text="%param.image.highSpeed"/>
                        </VBox>
                    </TitledPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- 底部固定两行（不参与滚动）：倒数第二行=配置管理，最后一行=取消/确定。
         Q6a：这两行从 HBox 改成 FlowPane —— 面板不再只有"模态窗口的固定 640px 宽"，
         它同时要装进占主界面 50% 的覆盖式侧边栏（900px 窗口时只有 ~442px）。
         HBox 会把子控件压到 pref 之下（按钮文字被省略号截断），FlowPane 宽度不足即换行、
         按钮恒以 pref 绘制 —— 与本项目「多按钮行一律用 FlowPane」的布局规则一致。
         单行放得下时两者的渲染结果一致（模态窗口不变，UiProbe -Dialog 截断数仍为 0）。
         本改动不涉及任何 fx:id / 类型注入 ⇒ 无 native 元数据影响。 -->
    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="12" bottom="12" left="12"/>
            </padding>

            <FlowPane hgap="10" vgap="6" alignment="CENTER_LEFT">
                <Label text="%param.config.label"/>
                <ComboBox fx:id="configComboBox" prefWidth="200" promptText="%param.config.select"/>
                <Button text="%param.config.load" onAction="#onLoadConfig">
                    <tooltip>
                        <Tooltip text="%param.config.loadNote"/>
                    </tooltip>
                </Button>
                <Button text="%param.config.save" onAction="#onSaveConfig"/>
                <Button text="%param.config.delete" onAction="#onDeleteConfig"/>
            </FlowPane>

            <FlowPane hgap="10" vgap="6" alignment="CENTER_RIGHT">
                <Button fx:id="cancelButton" text="%param.cancel" onAction="#onCancel"/>
                <Button fx:id="confirmButton" text="%param.ok" onAction="#onConfirm" styleClass="action-button" defaultButton="true"/>
            </FlowPane>
        </VBox>
    </bottom>
</fx:root>
