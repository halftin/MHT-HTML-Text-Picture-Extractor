<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import com.mhtextractor.gui.component.LogTextArea?>
<?import atlantafx.base.controls.ToggleSwitch?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mhtextractor.gui.controller.MainController"
            prefWidth="1100" prefHeight="700">

    <!-- 顶部：控制栏（模式选择 + 输入/输出目录） -->
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- 模式选择 ToggleGroup：互斥由 group 承担，允许取消选中回到"未选择"态 -->
            <fx:define>
                <ToggleGroup fx:id="modeToggleGroup"/>
            </fx:define>

            <!-- 标题栏 -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="%main.modeSelection" styleClass="title-3"/>
                <HBox spacing="0">
                    <ToggleButton fx:id="textModeToggle" text="%main.textExtract" toggleGroup="$modeToggleGroup">
                        <styleClass>
                            <String fx:value="left-pill"/>
                            <String fx:value="mode-pill"/>
                        </styleClass>
                        <graphic>
                            <FontIcon iconLiteral="fas-file-alt" iconSize="24"/>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="imageModeToggle" text="%main.imageExtract" toggleGroup="$modeToggleGroup">
                        <styleClass>
                            <String fx:value="right-pill"/>
                            <String fx:value="mode-pill"/>
                        </styleClass>
                        <graphic>
                            <FontIcon iconLiteral="fas-file-image" iconSize="24"/>
                        </graphic>
                    </ToggleButton>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="%main.title" styleClass="heading-3"/>
            </HBox>

            <!-- 输入/输出目录 -->
            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="80" prefWidth="80"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                </columnConstraints>

                <Label text="%main.inputDir" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="inputFolderField" promptText="%main.inputDirPrompt" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Button fx:id="browseInputButton" text="%main.browse" onAction="#onBrowseInput" GridPane.rowIndex="0" GridPane.columnIndex="2">
                    <graphic>
                        <FontIcon iconLiteral="fas-folder-open" iconSize="14"/>
                    </graphic>
                </Button>

                <Label text="%main.outputDir" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="outputFolderField" promptText="%main.outputDirPrompt" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Button fx:id="browseOutputButton" text="%main.browse" onAction="#onBrowseOutput" GridPane.rowIndex="1" GridPane.columnIndex="2">
                    <graphic>
                        <FontIcon iconLiteral="fas-folder-open" iconSize="14"/>
                    </graphic>
                </Button>
            </GridPane>
        </VBox>
    </top>

    <!-- 中间：预览工作台（左侧提取顺序列表 + 右侧信息区与内容区） -->
    <center>
        <HBox spacing="10">
            <padding>
                <Insets top="0" right="8" bottom="8" left="16"/>
            </padding>
            <VBox HBox.hgrow="ALWAYS" spacing="4" prefWidth="640">
                <!-- 列头：全选 / 章号 / 顺序 / 文件名 / 状态 -->
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="2" right="10" bottom="2" left="10"/>
                    </padding>
                    <CheckBox fx:id="selectAllCheck" minWidth="40" prefWidth="40" maxWidth="40"
                              alignment="CENTER" focusTraversable="false" style="-fx-padding: 0;">
                        <tooltip>
                            <Tooltip text="%main.selectAllToggle"/>
                        </tooltip>
                    </CheckBox>
                    <Label fx:id="badgeHeaderLabel" text="%main.chapterNo" prefWidth="40" styleClass="text-muted"/>
                    <Label text="%main.order" prefWidth="40" styleClass="text-muted"/>
                    <Label text="%main.fileName" styleClass="text-muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%main.status" styleClass="text-muted"/>
                </HBox>
                <StackPane VBox.vgrow="ALWAYS">
                    <ListView fx:id="fileListView"/>
                    <Pane fx:id="dragOverlay" mouseTransparent="true"/>
                </StackPane>

                <!-- 按钮行：撤销 / 合并为组 / 拆分组 / 移除 / 清除参数 / 将参数应用到全局 / 查看HTML源码（顺序固定；合并为组阶段 4、拆分组阶段 6 启用） -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="4" right="10" bottom="2" left="10"/>
                    </padding>
                    <Button fx:id="undoButton" text="%main.undo" onAction="#onUndoClicked" disable="true">
                        <graphic>
                            <FontIcon iconLiteral="fas-undo" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button fx:id="groupButton" text="%main.mergeGroup" onAction="#onGroupClicked" disable="true">
                        <graphic>
                            <FontIcon iconLiteral="fas-object-group" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button fx:id="ungroupButton" text="%main.ungroup" onAction="#onUngroupClicked" disable="true">
                        <graphic>
                            <FontIcon iconLiteral="fas-object-ungroup" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button fx:id="removeButton" text="%main.remove" onAction="#onRemoveClicked" disable="true">
                        <graphic>
                            <FontIcon iconLiteral="fas-trash-alt" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button fx:id="clearParamsButton" text="%main.clearParams" onAction="#onClearParamsClicked" disable="true">
                        <graphic>
                            <FontIcon iconLiteral="fas-eraser" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button fx:id="applyGlobalButton" text="%main.applyGlobal" onAction="#onApplyGlobalClicked" disable="true">
                        <graphic>
                            <FontIcon iconLiteral="fas-globe" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button fx:id="viewSourceButton" text="%main.viewHtmlSource" onAction="#onViewSourceButton" disable="true">
                        <graphic>
                            <FontIcon iconLiteral="fas-code" iconSize="14"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="400">
                <padding>
                    <Insets top="0" right="16" bottom="0" left="0"/>
                </padding>

                <!-- 模式/文件计数/提取参数设置按钮 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="modeLabel" text="%main.modeLabel"/>
                    <Label fx:id="fileCountLabel" text="%main.fileCountZero"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="paramSettingsButton" text="%main.paramSettings" onAction="#onParamSettings">
                        <graphic>
                            <FontIcon iconLiteral="fas-sliders-h" iconSize="14"/>
                        </graphic>
                    </Button>
                </HBox>

                <!-- 信息区：输出模式 / 输出文件名 / 提取标题 / 输出结果或逐文件调整 -->
                <VBox spacing="4">
                    <Label fx:id="outputModeLabel" text="%main.outputMode"/>
                    <Label fx:id="outputNameLabel" wrapText="true" visible="false" managed="false"/>
                    <HBox fx:id="groupNameBox" spacing="6" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Label text="%main.outputGroupFile"/>
                        <TextField fx:id="groupNameField" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="titleInfoLabel" wrapText="true" visible="false" managed="false"/>
                    <Label fx:id="outputResultLabel" wrapText="true" visible="false" managed="false"/>
                    <CheckBox fx:id="adjustCheck" text="" visible="false" managed="false"/>
                </VBox>

                <!-- 内容区：文本 / 图片按模式切换 -->
                <StackPane VBox.vgrow="ALWAYS">
                    <TextArea fx:id="textPreviewArea" wrapText="true" editable="false"/>
                    <VBox fx:id="imagePreviewBox" spacing="10" alignment="TOP_CENTER">
                        <Label fx:id="imageHintLabel" wrapText="true" textAlignment="CENTER"/>
                        <Button fx:id="previewEffectButton" text="%main.previewButton" onAction="#onPreviewEffect"/>
                        <Label fx:id="renameNoteLabel" text="%main.globalNoNote" styleClass="text-muted"
                               visible="false" managed="false"/>
                        <ScrollPane fx:id="imageScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                                    visible="false" managed="false">
                            <FlowPane fx:id="thumbnailPane" hgap="10" vgap="10"/>
                        </ScrollPane>
                    </VBox>
                    <!-- 提取结果提示 banner（提取结果状态需求）：预览区顶部，选中含红条目时显示详情 -->
                    <Label fx:id="extractResultBanner" wrapText="true" visible="false" managed="false"
                           maxWidth="Infinity" StackPane.alignment="TOP_LEFT"
                           style="-fx-background-color: #f8d7da; -fx-text-fill: #721c24; -fx-font-weight: bold; -fx-padding: 8 10;"/>
                </StackPane>
            </VBox>
        </HBox>
    </center>

    <!-- 底部：进度 / 状态 / 完成后操作 / 提取按钮 / 日志 -->
    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="5" right="10" bottom="10" left="10"/>
            </padding>

            <!-- 进度条 -->
            <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity" visible="false"/>
            <Label fx:id="statusLabel" text="%main.statusReady" styleClass="text-small"/>

            <!-- 完成后操作 -->
            <ToggleSwitch fx:id="openFolderAfterCompleteCheck" text="%main.openFolderAfter"/>

            <!-- 操作按钮 -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="startButton" text="%main.startExtract" onAction="#onStartProcessing" styleClass="action-button">
                    <graphic>
                        <FontIcon iconLiteral="fas-play" iconSize="14"/>
                    </graphic>
                </Button>
                <Button fx:id="stopButton" text="%main.stop" onAction="#onStopProcessing"
                        disable="true" styleClass="stop-button">
                    <graphic>
                        <FontIcon iconLiteral="fas-stop" iconSize="14"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- 日志区域 -->
            <LogTextArea fx:id="logTextArea" prefHeight="150" VBox.vgrow="ALWAYS"/>
        </VBox>
    </bottom>
</BorderPane>
